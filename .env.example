# Backend configuration (copy to .env)
APP_ENV=development
ELEXON_BASE_URL=https://data.elexon.co.uk/bmrs/api/v1
ANALYSIS_START=2026-01-01
ANALYSIS_END=2026-01-31

# Documented assumption: latest forecast published at or before 09:30 Europe/London
# on the calendar day before delivery is eligible.
DECISION_CUTOFF_TIME=09:30
DECISION_CUTOFF_TZ=Europe/London
DECISION_CUTOFF_INCLUSIVE=true

# live = fetch from Elexon (falls back to snapshot), snapshot = use stored real data only
DATA_MODE=live
SNAPSHOT_PATH=data/snapshot_january_2026.json
CACHE_DIR=.cache
CACHE_TTL_SECONDS=604800

ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
UPSTREAM_TIMEOUT_SECONDS=30
UPSTREAM_MAX_RETRIES=3
MAX_RANGE_DAYS=31
